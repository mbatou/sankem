# ─────────────────────────────────────────────────────────────────────────────
# Site
# ─────────────────────────────────────────────────────────────────────────────
# Public canonical URL of the storefront (no trailing slash).
# Used for metadata, sitemap, OG images, and Wave success/error callbacks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# Supabase
# ─────────────────────────────────────────────────────────────────────────────
# Project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key (safe to expose to the browser; RLS enforces access).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — SERVER ONLY. Bypasses RLS. Never expose to the client.
# Used by server actions / webhooks that must write orders, etc.
SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket name for product images (created by migration 0003).
NEXT_PUBLIC_SUPABASE_PRODUCT_BUCKET=product-images

# ─────────────────────────────────────────────────────────────────────────────
# Admin allowlist
# ─────────────────────────────────────────────────────────────────────────────
# Comma-separated list of email addresses allowed into /admin. These accounts
# must also exist in Supabase Auth. Single admin is fine to start.
ADMIN_EMAILS=georgesmbatoucharles@gmail.com

# ─────────────────────────────────────────────────────────────────────────────
# Wave (mobile money — Senegal). SERVER ONLY.
# ─────────────────────────────────────────────────────────────────────────────
# Secret API key for the Wave Checkout Sessions API.
WAVE_API_KEY=
# Base URL of the Wave API. TODO: confirm exact value with Wave docs.
WAVE_API_BASE_URL=https://api.wave.com
# Secret used to verify inbound webhook signatures. TODO: confirm.
WAVE_WEBHOOK_SECRET=
